# ==============================================================================
# rag-trace-collector-worker — Environment Configuration Example
# ==============================================================================
# NOTE: `.env` is for LOCAL DEVELOPMENT ONLY.
# Production/deployment configuration is governed by `.env.prod` (gitignored),
# which is synced to `deployments/helm/values.yaml` via:
#   python scripts/sync_env_to_deployments.py --sync
# Only changes to `.env.prod` affect `deployments/`.
#
# Copy this file to `.env` and adjust values for local development.
# Process environment variables take precedence over values defined in `.env`.
# ==============================================================================

# ------------------------------------------------------------------------------
# Multi-process supervisor & lifecycle
# ------------------------------------------------------------------------------
WORKER_PROCESS_COUNT=4
GRACEFUL_DRAIN_TIMEOUT_SECONDS=20.0
WORKER_HEARTBEAT_INTERVAL_SECONDS=2.0
WORKER_HEARTBEAT_TIMEOUT_SECONDS=10.0
WORKER_RESPAWN_INITIAL_BACKOFF_SECONDS=0.5
WORKER_RESPAWN_MAX_BACKOFF_SECONDS=30.0
WORKER_MAX_RESTARTS_IN_WINDOW=10
WORKER_RESTART_WINDOW_SECONDS=60.0

# ------------------------------------------------------------------------------
# Kafka ingress (rag-diagnostic-traces, 32 partitions, key=hash(trace_id))
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=rag-diagnostic-traces
KAFKA_TOPIC_PARTITIONS=32
KAFKA_GROUP_ID=rag-trace-collector-worker
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Required when KAFKA_SECURITY_PROTOCOL is SASL_PLAINTEXT or SASL_SSL (PLAIN for Confluent Cloud, or SCRAM-SHA-256 / SCRAM-SHA-512):
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# Optional TLS client/CA files when using SSL or SASL_SSL:
# KAFKA_SSL_CAFILE=
# KAFKA_SSL_CERTFILE=
# KAFKA_SSL_KEYFILE=
# KAFKA_SSL_KEY_PASSWORD=
KAFKA_MAX_POLL_INTERVAL_MS=300000
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_HEARTBEAT_INTERVAL_MS=3000
KAFKA_MAX_PAYLOAD_BYTES=1048576
KAFKA_MAX_POLL_RECORDS=500
KAFKA_FETCH_MAX_BYTES=16777216
KAFKA_MAX_PARTITION_FETCH_BYTES=1048576
KAFKA_MAX_IN_FLIGHT_OFFSETS=10000
KAFKA_OFFSET_COMMIT_INTERVAL_SECONDS=1.0

# ------------------------------------------------------------------------------
# Redis 7.2 Cluster provenance cache
# ------------------------------------------------------------------------------
# Local dev (docker-compose.redis.yml): localhost:6379
# In-cluster headless DNS (.env.prod):
#   rag-trace-collector-worker-redis-0.rag-trace-collector-worker-redis-headless.rag-telemetry.svc.cluster.local:6379,...
REDIS_CLUSTER_NODES=localhost:6379
# REDIS_PASSWORD=
REDIS_TLS_ENABLED=false
# REDIS_SSL_CAFILE=
REDIS_LRU_CAPACITY=50000
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
REDIS_PIPELINE_BATCH_SIZE=256

# ------------------------------------------------------------------------------
# ClickHouse 24.3+ native TCP sink
# ------------------------------------------------------------------------------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=rag_traces
CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
CLICKHOUSE_TLS_ENABLED=false
# CLICKHOUSE_SSL_CAFILE=
CLICKHOUSE_CONNECT_TIMEOUT_SECONDS=5.0
CLICKHOUSE_SEND_RECEIVE_TIMEOUT_SECONDS=10.0
CLICKHOUSE_INSERT_DEDUPLICATE=true
CLICKHOUSE_ASYNC_INSERT=false
CLICKHOUSE_REPLICATED=true
CLICKHOUSE_CLUSTER_NAME=rag_cluster

# ------------------------------------------------------------------------------
# Time-wheel DAG assembly, micro-batching & local disk WAL spillover
# ------------------------------------------------------------------------------
TIMEWHEEL_EXPIRY_SECONDS=1.5
TIMEWHEEL_TICK_MS=50
TIMEWHEEL_MAX_OPEN_TRACES=25000
BATCH_MAX_ROWS=50000
BATCH_FLUSH_INTERVAL_SECONDS=2.0
BATCH_MAX_PENDING_BATCHES=4
DISK_WAL_DIR=/var/spool/trace-wal
DISK_WAL_MAX_BYTES=536870912
DISK_WAL_DRAIN_INTERVAL_SECONDS=2.0

# ------------------------------------------------------------------------------
# Telemetry, structured logging & allocator (Linux/container runtime)
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
TELEMETRY_HOST=127.0.0.1
TELEMETRY_PORT=8080
PROMETHEUS_MULTIPROC_DIR=
# Linux/container jemalloc runtime tuning (see deployments/docker/Dockerfile):
# MALLOC_CONF=background_thread:true,dirty_decay_ms:1000,muzzy_decay_ms:2000
# LD_PRELOAD=/usr/local/lib/libjemalloc.so.2
